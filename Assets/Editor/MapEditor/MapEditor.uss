/* 基础布局 */
#FileList {
    background-color: #2d2d2d;
    border-right: 1px solid #444;
    padding: 5px;
}

#EidtorMain {
    background-color: #1e1e1e;
    padding: 10px;
}

#Inspector {
    background-color: #2d2d2d;
    border-left: 1px solid #444;
    padding: 10px;
}

/* 按钮样式 */
Button {
    background-color: #3c3c3c;
    color: #dcdcdc;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 4px;
    font-size: 12px;
}

Button:hover {
    background-color: #4a4a4a;
}

/* 表格样式 */
.map-title {
    font-size: 16px;
    font-weight: bold;
    color: #f0f0f0;
    margin-bottom: 10px;
}

ScrollView {
    margin-top: 10px;
    background-color: #252526;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 5px;
}

/* TreeView样式 */
TreeView {
    background-color: #252526;
    border: 1px solid #444;
    border-radius: 4px;
    margin-top: 5px;
}

Label {
    color: #dcdcdc;
    padding: 4px 8px;
}

Label:hover {
    background-color: #3a3a3a;
}