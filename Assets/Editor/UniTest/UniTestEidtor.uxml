<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1; width: 100%; height: 30px; border-bottom-width: 1px; border-left-color: rgba(0, 0, 0, 0.58); border-right-color: rgba(0, 0, 0, 0.58); border-top-color: rgba(0, 0, 0, 0.58); border-bottom-color: rgba(0, 0, 0, 0.58);">
            <ui:DropdownField label="Type" name="TypeChoice" style="width: 98%; height: 100%; -unity-text-align: middle-left; border-bottom-width: 2px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-top-width: 2px; border-right-width: 2px; border-left-width: 2px;" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; border-bottom-width: 1px;">
            <ui:ScrollView name="ButtonScroll" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
